{
  "cli": {
    "version": ">= 15.0.9",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "env": {
        "BUILD_PROFILE": "preview"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "env": {
        "BUILD_PROFILE": "development"
      }
    },
    "production": {
      "node": "23.2.0",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "BUILD_PROFILE": "production"
      }
    }
  }
}
